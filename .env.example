DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,aidl-backend.onrender.com
TIME_ZONE=Asia/Kolkata

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=aidl

# Frontend (after Microsoft login, tokens land here)
FRONTEND_URL=https://aidl-frontend-8owk.vercel.app
AUTH_SUCCESS_REDIRECT=https://aidl-frontend-8owk.vercel.app/auth/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://aidl-frontend-8owk.vercel.app

# Microsoft / Teams OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# --- PRODUCTION (Render) — use these on aidl-backend.onrender.com ---
MICROSOFT_REDIRECT_URI=https://aidl-backend.onrender.com/api/auth/teams/callback/
MS_REDIRECT_URI=https://aidl-backend.onrender.com/api/auth/teams/callback/

# --- LOCAL only (uncomment for laptop testing; do NOT use on Render) ---
# MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/
# MS_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/
# AUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
# DEBUG=True

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_SCOPES=User.Read

# JWT
JWT_SECRET=change-me-to-long-random-string-min-32-chars
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
