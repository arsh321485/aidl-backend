DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,vaptbackend.secureitlab.com
TIME_ZONE=Asia/Kolkata

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=aidl

# Frontend
FRONTEND_URL=https://aidl-frontend-8owk.vercel.app
AUTH_SUCCESS_REDIRECT=http://localhost:8000/
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,https://aidl-frontend-8owk.vercel.app,https://vaptbackend.secureitlab.com

# Microsoft / Teams OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/
MS_SCOPES=User.Read

# JWT
JWT_SECRET=change-me-to-long-random-string-min-32-chars
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
