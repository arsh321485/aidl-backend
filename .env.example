DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,aidl-backend.onrender.com
TIME_ZONE=Asia/Kolkata

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=aidl

# Frontend — tokens land on /auth/callback (TeamsCallbackView)
FRONTEND_URL=https://aidl-frontend-8owk.vercel.app
AUTH_SUCCESS_REDIRECT=https://aidl-frontend-8owk.vercel.app/auth/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5184,https://aidl-frontend-8owk.vercel.app

# Microsoft / Teams OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_SCOPES=User.Read,Team.ReadBasic.All,Team.Create,Channel.ReadBasic.All,Channel.Create,ChannelMessage.Send,TeamsTab.Create,TeamsTab.ReadWrite.All,Group.ReadWrite.All

# Auto-create Team "AIDL" + channel "aidl dashboard" on Microsoft login
MS_AIDL_TEAM_NAME=AIDL
MS_AIDL_CHANNEL_NAME=aidl dashboard
MS_AIDL_AUTO_CREATE_TEAM=True
MS_SEND_WELCOME_CARD=True
MS_SEND_ADMIN_CARD_EVERY_LOGIN=True
MS_AIDL_LAND_ON_POSTS=True
MS_AIDL_INSTALL_CHANNEL_TABS=False
MS_TEAMS_APP_BASE_URL=https://aidl-backend.onrender.com/api/teams
AIDL_ORG_DISPLAY_NAME=Northwind Logistics
AIDL_POLICY_URL=https://www.spinifexit.com/acceptable-use-policy
# Optional override (skip auto-create team):
# MS_AIDL_TEAM_ID=

# --- PRODUCTION (Render Dashboard) ---
MICROSOFT_REDIRECT_URI=https://aidl-backend.onrender.com/api/auth/teams/callback/
MS_REDIRECT_URI=https://aidl-backend.onrender.com/api/auth/teams/callback/

# --- LOCAL laptop only (do NOT use these on Render) ---
# DEBUG=True
# MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/
# MS_REDIRECT_URI=http://localhost:8000/api/auth/teams/callback/
# AUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# Sign in with Slack — redirect URL in the Slack app must match SLACK_REDIRECT_URI.
# Slack requires https: for local testing use an ngrok URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://aidl-backend.onrender.com/api/auth/slack/callback/
# Basic Information → Signing Secret (button clicks); channel for the Admin cards
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_NAME=aidl-driving-license

# JWT
JWT_SECRET=change-me-to-long-random-string-min-32-chars
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Local only: set True if outbound calls are slow because your network's IPv6 DNS doesn't answer.
# FORCE_IPV4_OUTBOUND=True

# Website sign-up / sign-in checks (api/auth_verification.py): picture
# captcha on sign-in, emailed 6-digit code on sign-up and sign-in.
# The code is emailed through SendGrid (preferred) or SMTP (EMAIL_HOST...).
# With neither set, codes are only printed in the server log.
AUTH_CAPTCHA=True
AUTH_EMAIL_OTP=True
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=AIDL <info@grcmentor.ai>

# Plan upgrades (billing.py / stripe_billing.py)
BILLING_PROVIDER=stripe
BILLING_TEST_MODE=False
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_ENTERPRISE=
BILLING_SALES_EMAIL=
BILLING_UNLIMITED_ADMIN_EMAILS=
PLAN_PRICE_BASIC=
PLAN_PRICE_ENTERPRISE=
BACKEND_URL=https://aidl-backend.onrender.com
# Website waitlist sign-ups are emailed here (empty = BILLING_SALES_EMAIL).
WAITLIST_NOTIFY_EMAIL=
# Uploaded AUP → 14 cards with an NVIDIA hosted model (nvidia_ai.py, aup_upload.py).
# Key from build.nvidia.com ("nvapi-…"); model id as shown on the model's page, e.g. meta/llama-3.3-70b-instruct.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STATUS_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/status
NVIDIA_TIMEOUT=600
NVIDIA_MAX_TOKENS=8000
NVIDIA_TEMPERATURE=0.2
# Extra request fields some models need, as JSON, e.g. {"chat_template_kwargs": {"thinking": false}}
NVIDIA_EXTRA_BODY=
AUP_UPLOAD_PLANS=basic,enterprise
AUP_UPLOAD_MAX_BYTES=10485760
AUP_UPLOAD_MAX_CHARS=120000
# Regulator card: show entries not yet compliance-reviewed (marked DRAFT). Test workspaces only.
REGULATORS_PREVIEW=False
# "Request a new card" (Card approval) is emailed here (empty = BILLING_SALES_EMAIL).
CARD_REQUEST_EMAIL=
